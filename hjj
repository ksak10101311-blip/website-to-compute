  const addToCart = (product) => {
    const existingItem = cart.find(item => item.id === product.id);
    if (existingItem) {
      setCart(cart.map(item => 
        item.id === product.id 
          ? { ...item, quantity: item.quantity + 1 }
          : item
      ));
    } else {
      setCart([...cart, { ...product, quantity: 1 }]);
    }
  };

  const removeFromCart = (productId) => {
    setCart(cart.filter(item => item.id !== productId));
  };

  const updateQuantity = (productId, newQuantity) => {
    if (newQuantity === 0) {
      removeFromCart(productId);
    } else {
      setCart(cart.map(item => 
        item.id === productId 
          ? { ...item, quantity: newQuantity }
          : item
      ));
    }
  };

  const getTotalPrice = () => {
    return cart.reduce((total, item) => total + (item.price * item.quantity), 0);
  };

  // Apple Pay Integration
  const initializeApplePay = () => {
    if (window.ApplePaySession && ApplePaySession.canMakePayments()) {
      const merchantIdentifier = 'merchant.com.jawaad.store';
      const supportedNetworks = ['visa', 'mastercard', 'amex', 'mada'];
      const countryCode = 'SA';

      const paymentRequest = {
        countryCode: countryCode,
        currencyCode: 'SAR',
        supportedNetworks: supportedNetworks,
        merchantCapabilities: ['supports3DS', 'supportsEMV'],
        total: {
          label: 'متجر جواد',
          amount: getTotalPrice().toString()
        },
        lineItems: cart.map(item => ({
          label: `${item.name} x${item.quantity}`,
          amount: (item.price * item.quantity).toString()
        }))
      };

      const session = new ApplePaySession(3, paymentRequest);

      session.onvalidatemerchant = function(event) {
        // في التطبيق الحقيقي، يجب إرسال طلب إلى الخادم للتحقق من صحة التاجر
        console.log('Validating merchant for Apple Pay');
        // session.completeMerchantValidation(merchantSession);
      };

      session.onpaymentauthorized = function(event) {
        // معالجة الدفع هنا
        console.log('Payment authorized:', event.payment);
        
        // محاكاة معالجة الدفع
        setTimeout(() => {
          const orderNumber = 'JW' + Date.now();
          setOrderConfirmation({
            order_number: orderNumber,
            total: getTotalPrice(),
            items: cart,
            payment_method: 'Apple Pay',
            whatsapp_link: `https://wa.me/966501234567?text=${encodeURIComponent(`طلب جديد رقم: ${orderNumber}`)}`
          });
          
          session.completePayment(ApplePaySession.STATUS_SUCCESS);
          setShowCheckout(false);
          setShowOrderConfirmation(true);
          setCart([]);
        }, 2000);
      };

      session.begin();
    } else {
      alert('Apple Pay غير متاح على هذا الجهاز');
    }
  };

  const processPayment = async () => {
    if (!paymentMethod || !customerPhone) {
      alert('يرجى ملء جميع البيانات المطلوبة');
      return;
    }

    if (paymentMethod === 'apple_pay') {
      initializeApplePay();
      return;
    }

    setIsProcessingPayment(true);

    // محاكاة معالجة الدفع
    setTimeout(() => {
      const orderNumber = 'JW' + Date.now();
      setOrderConfirmation({
        order_number: orderNumber,
        total: getTotalPrice(),
        items: cart,
        payment_method: paymentMethod === 'credit_card' ? 'بطاقة ائتمانية' : 'تحويل بنكي',
        whatsapp_link: `https://wa.me/966501234567?text=${encodeURIComponent(`طلب جديد رقم: ${orderNumber}`)}`
      });
      setShowCheckout(false);
      setShowOrderConfirmation(true);
      setCart([]);
      setIsProcessingPayment(false);
    }, 2000);
  };

