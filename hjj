            <div>
              <h4 className="text-lg font-bold text-white mb-3">طريقة الدفع</h4>
              <div className="space-y-3">
                {window.ApplePaySession && ApplePaySession.canMakePayments() && (
                  <label className="flex items-center p-3 rounded-xl bg-white/10 border border-white/20 cursor-pointer hover:bg-white/20 transition-colors">
                    <input
                      type="radio"
                      name="payment"
                      value="apple_pay"
                      checked={paymentMethod === 'apple_pay'}
                      onChange={(e) => setPaymentMethod(e.target.value)}
                      className="ml-3"
                    />
                    <span className="text-white">🍎 Apple Pay</span>
                  </label>
                )}
                <label className="flex items-center p-3 rounded-xl bg-white/10 border border-white/20 cursor-pointer hover:bg-white/20 transition-colors">
                  <input
                    type="radio"
                    name="payment"
                    value="credit_card"
                    checked={paymentMethod === 'credit_card'}
                    onChange={(e) => setPaymentMethod(e.target.value)}
                    className="ml-3"
                  />
                  <span className="text-white">💳 بطاقة ائتمانية</span>
                </label>
                <label className="flex items-center p-3 rounded-xl bg-white/10 border border-white/20 cursor-pointer hover:bg-white/20 transition-colors">
                  <input
                    type="radio"
                    name="payment"
                    value="bank_transfer"
                    checked={paymentMethod === 'bank_transfer'}
                    onChange={(e) => setPaymentMethod(e.target.value)}
                    className="ml-3"
                  />
                  <span className="text-white">🏦 تحويل بنكي</span>
                </label>
              </div>
            </div>

            <button 
              className="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
              onClick={processPayment}
              disabled={isProcessingPayment}
            >
              {isProcessingPayment ? 'جاري المعالجة...' : 'تأكيد الدفع'}
            </button>
          </div>
        </div>
      </div>
    );
  };

  const renderOrderConfirmation = () => {
    if (!showOrderConfirmation || !orderConfirmation) return null;

    return (
      <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div className="bg-white/10 backdrop-blur-lg border border-white/20 rounded-2xl p-6 w-full max-w-md text-center">
          <div className="text-6xl mb-4">✅</div>
          <h3 className="text-2xl font-bold text-white mb-4">تم تأكيد طلبك!</h3>
          <p className="text-white/90 mb-2">رقم الطلب: <span className="font-bold text-yellow-400">{orderConfirmation.order_number}</span></p>
          <p className="text-white/90 mb-2">المبلغ: <span className="font-bold text-yellow-400">{orderConfirmation.total} ريال</span></p>
          <p className="text-white/90 mb-6">طريقة الدفع: <span className="font-bold">{orderConfirmation.payment_method}</span></p>
          
          <div className="space-y-3">
            <a 
              href={orderConfirmation.whatsapp_link}
              className="block w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300"
            >
              تواصل عبر واتساب
            </a>
            <button 
              className="w-full bg-white/20 hover:bg-white/30 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300"
              onClick={() => {
                setShowOrderConfirmation(false);
                setCurrentPage('home');
              }}
            >
              العودة للمتجر
            </button>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-600 via-blue-600 to-purple-800">
      {renderHeader()}
      
      {currentPage === 'home' && (
        <>
          {renderHero()}
          {renderProducts()}
        </>
      )}
      
      {currentPage === 'rewards' && renderRewards()}
      {currentPage === 'contact' && renderContact()}
      
      {renderCart()}
      {renderCheckout()}
      {renderOrderConfirmation()}
    </div>
  );
}

export default App;
